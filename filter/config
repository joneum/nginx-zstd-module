ngx_feature_incs="#include <zstd.h>"
ngx_feature_test="(void) ZSTD_createCCtx();"
ngx_feature_libs=
ngx_feature_run=yes

ngx_zstd_opt_I=
ngx_zstd_opt_L=
ngx_zstd_sys_I=
ngx_zstd_sys_L=

if [ -n "$ZSTD_INC" -o -n "$ZSTD_LIB" ]; then
    ngx_zstd_where="in $ZSTD_INC and $ZSTD_LIB"
    ngx_zstd_sys_I="-I$ZSTD_INC"
    ngx_zstd_sys_L="-L$ZSTD_LIB"
    ngx_feature_path=$ZSTD_INC
    ngx_zstd_archive="$ZSTD_LIB/libzstd.a"
else
    ngx_zstd_where=
    ngx_zstd_archive="-l:libzstd.a"

    # FreeBSD and the other ports-based systems keep zstd.h and libzstd
    # under /usr/local, where the compiler does not look on its own.
    # Without this the probe fails on a machine that has zstd installed.
    if [ ! -f /usr/include/zstd.h ] && [ -f /usr/local/include/zstd.h ]; then
        ngx_zstd_sys_I="-I/usr/local/include"
        ngx_zstd_sys_L="-L/usr/local/lib"
        ngx_feature_path=/usr/local/include
        ngx_zstd_archive="/usr/local/lib/libzstd.a"
    fi
fi

# ZSTD_createCStream_advanced() and ZSTD_createCDict_byReference() are only
# declared when ZSTD_STATIC_LINKING_ONLY is defined, and this module calls
# both.  The flag used to reach the compiler through the static module's
# config fragment, which meant the filter did not build without it.
ngx_zstd_opt_I="$ngx_zstd_sys_I -DZSTD_STATIC_LINKING_ONLY"

ngx_zstd_try() {
    ngx_feature="ZStandard $1 library $ngx_zstd_where"
    ngx_zstd_opt_L="$2"

    ngx_zstd_saved_cc=$CC_TEST_FLAGS
    ngx_zstd_saved_ld=$NGX_TEST_LD_OPT
    CC_TEST_FLAGS="$ngx_zstd_opt_I $CC_TEST_FLAGS"
    NGX_TEST_LD_OPT="$ngx_zstd_opt_L $NGX_TEST_LD_OPT"

    . auto/feature

    CC_TEST_FLAGS=$ngx_zstd_saved_cc
    NGX_TEST_LD_OPT=$ngx_zstd_saved_ld
}

# The module uses ZStandard functions that are only exported for static
# linking, so the archive is what it wants.  A loadable module cannot
# carry one that was built without -fPIC, however, and that is how
# Debian and Ubuntu ship libzstd.a: linking it into a shared object ends
# in "relocation R_X86_64_PC32 ... can not be used when making a shared
# object".  For a loadable module the shared library therefore comes
# first, for a module built into the binary the archive does.

if [ "$ngx_module_link" = DYNAMIC ]; then
    ngx_zstd_try dynamic "$ngx_zstd_sys_L -lzstd"
    if [ $ngx_found = no ]; then
        ngx_zstd_try static "$ngx_zstd_sys_L $ngx_zstd_archive"
    fi
else
    ngx_zstd_try static "$ngx_zstd_sys_L $ngx_zstd_archive"
    if [ $ngx_found = no ]; then
        ngx_zstd_try dynamic "$ngx_zstd_sys_L -lzstd"
    fi
fi

if [ $ngx_found = no ]; then
    cat << END
$0: error: ngx_http_zstd_filter_module requires the ZStandard library.
Install it, or point ZSTD_INC at the directory holding zstd.h and
ZSTD_LIB at the one holding the library.
END
    exit 1
fi

CFLAGS="$ngx_zstd_opt_I $CFLAGS"

HTTP_ZSTD_SRCS="$ngx_addon_dir/src/ngx_http_zstd_filter_module.c"

ngx_addon_name=ngx_http_zstd_filter_module
ngx_module_type=HTTP_FILTER
ngx_module_name=ngx_http_zstd_filter_module
ngx_module_incs="$ngx_zstd_opt_I"
ngx_module_srcs=$HTTP_ZSTD_SRCS

# the library belongs to this module only.  Putting it into NGX_LD_OPT is
# build-global and hangs a libzstd on every other dynamic module of the
# same build, mail and stream among them.
ngx_module_libs=$ngx_zstd_opt_L

ngx_module_order="$ngx_module_name \
                  ngx_pagespeed \
                  ngx_http_postpone_filter_module \
                  ngx_http_ssi_filter_module \
                  ngx_http_charset_filter_module \
                  ngx_http_xslt_filter_module \
                  ngx_http_image_filter_module \
                  ngx_http_sub_filter_module \
                  ngx_http_addition_filter_module \
                  ngx_http_gunzip_filter_module \
                  ngx_http_userid_filter_module \
                  ngx_http_headers_filter_module \
                  ngx_http_copy_filter_module \
                  ngx_http_range_body_filter_module \
                  ngx_http_not_modified_filter_module \
                  ngx_http_slice_filter_module"

. auto/module

if [ "$ngx_module_link" != DYNAMIC ]; then
    # ngx_module_order doesn't work with static modules,
    # so we must re-order filters here.

    if [ "$HTTP_GZIP" = YES ]; then
        next=ngx_http_gzip_filter_module
    elif echo $HTTP_FILTER_MODULES | grep pagespeed_etag_filter >/dev/null; then
        next=ngx_pagespeed_etag_filter
    else
        next=ngx_http_range_header_filter_module
    fi

    HTTP_FILTER_MODULES=`echo $HTTP_FILTER_MODULES \
                         | sed "s/$ngx_module_name//" \
                         | sed "s/$next/$next $ngx_module_name/"`
fi
