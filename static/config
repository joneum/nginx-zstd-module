# ngx_http_zstd_static_module serves files that are already compressed.
# It looks at the request, at the file name and at Accept-Encoding, and
# never calls into libzstd, so it needs neither the header nor the
# library.  Probing for them here only put a needless libzstd on the
# module and made every build carry the dependency.

HTTP_ZSTD_SRCS="$ngx_addon_dir/src/ngx_http_zstd_static_module.c"

ngx_addon_name=ngx_http_zstd_static_module
ngx_module_type=HTTP
ngx_module_name=ngx_http_zstd_static_module
ngx_module_srcs=$HTTP_ZSTD_SRCS

# auto/module reads these from the environment, and the filter fragment
# ran before this one.  Without clearing them the static module inherits
# the filter's libzstd and links it although it calls nothing in it.
ngx_module_incs=
ngx_module_deps=
ngx_module_libs=
ngx_module_order=

. auto/module
